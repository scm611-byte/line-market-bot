LINE_CHANNEL_SECRET=你的_channel_secret
LINE_CHANNEL_ACCESS_TOKEN=你的_channel_access_token
# 排程觸發用的密碼，隨便產生一串長亂碼
CRON_SECRET=請改成隨機字串
# 你的 LINE user ID（LINE Developers → Basic settings → Your user ID），只有這個帳號能用 Bot
OWNER_USER_ID=Uxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 讀寫 data/portfolio.json 用的 GitHub token；本機開發可以留空，會改讀寫本機檔案
GITHUB_TOKEN=
# 期貨報價用的 FinMind token（免費帳號 → 使用者資訊 → api token）
FINMIND_TOKEN=
GITHUB_REPO=scm611-byte/line-market-bot
# 本機用 ngrok 測圖片時填 ngrok 網址
PUBLIC_URL=
PORT=5000
